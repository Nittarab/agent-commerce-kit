{
  "name": "@nittarab/agent-commerce-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private original agent payment control prototype",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "demo": "node examples/shared-budget/demo.ts",
    "policy:check": "node packages/policy/cli.ts policies/demo.json",
    "prepublishOnly": "node scripts/block-publication.mjs",
    "testnet:setup": "node apps/testnet/setup.ts",
    "testnet:run": "node apps/testnet/run.ts",
    "guide": "node scripts/guide.mjs",
    "dashboard": "node apps/dashboard/server.ts",
    "demo:swarm": "node apps/dashboard/swarm-demo.ts",
    "start": "node scripts/start.mjs",
    "demo:testnet": "node scripts/start.mjs --testnet"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "near-api-js": "7.5.3",
    "structured-headers": "2.1.1"
  }
}
